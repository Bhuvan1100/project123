```gitignore
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.out
*.test

# Go build output
/bin/
/build/
/dist/

# Test and coverage
coverage.out
coverage.html
*.coverprofile

# Go workspace
go.work
go.work.sum

# Environment / secrets
.env
.env.*
!.env.example

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/
```
